# Gemini CLI - Python + Gradio Edition
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override default model
GEMINI_MODEL=gemini-2.5-flash

# Optional: workspace root (defaults to current working directory)
GEMINI_WORKSPACE=.

# Optional: where sessions are stored (defaults to ~/.gemini-py/sessions)
GEMINI_SESSIONS_DIR=

# Optional: comma-separated MCP server command lines, e.g.
# GEMINI_MCP_SERVERS=npx -y @modelcontextprotocol/server-filesystem /tmp
GEMINI_MCP_SERVERS=
